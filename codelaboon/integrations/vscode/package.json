{
  "name": "codelaboon",
  "displayName": "Codelaboon",
  "description": "Native coding engines, shared sessions, and import/export across seven agents.",
  "publisher": "codelaboon",
  "version": "1.0.26",
  "preview": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:codelaboon.sessions",
    "onView:codelaboon.diagnostics"
  ],
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codelaboon.connectClaude",
        "title": "Codelaboon: Connect Claude Code"
      },
      {
        "command": "codelaboon.disconnectClaude",
        "title": "Codelaboon: Disconnect Claude Code"
      },
      {
        "command": "codelaboon.openClaude",
        "title": "Codelaboon: Open Claude Code"
      },
      {
        "command": "codelaboon.checkFreeModels",
        "title": "Codelaboon: Check Free Models"
      },
      {
        "command": "codelaboon.openTerminal",
        "title": "Codelaboon: Open Coding Terminal (OpenCode)"
      },
      {
        "command": "codelaboon.openEngineTerminal",
        "title": "Codelaboon: Open Optional Engine Terminal"
      },
      {
        "command": "codelaboon.connectCodex",
        "title": "Codelaboon: Connect Codex"
      },
      {
        "command": "codelaboon.disconnectCodex",
        "title": "Codelaboon: Disconnect Codex"
      },
      {
        "command": "codelaboon.openCodex",
        "title": "Codelaboon: Open Codex"
      },
      {
        "command": "codelaboon.importSession",
        "title": "Codelaboon: Import Session",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codelaboon.exportSession",
        "title": "Codelaboon: Export Session",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codelaboon.convertSession",
        "title": "Codelaboon: Convert Session Between Agents",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "codelaboon.resumeSession",
        "title": "Codelaboon: Resume Shared Session",
        "icon": "$(play)"
      },
      {
        "command": "codelaboon.refreshSessions",
        "title": "Codelaboon: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "codelaboon.refreshDiagnostics",
        "title": "Codelaboon: Refresh Diagnostics",
        "icon": "$(refresh)"
      },
      {
        "command": "codelaboon.evaluateController",
        "title": "Codelaboon: Evaluate Local Controller"
      }
    ],
    "configuration": {
      "title": "Codelaboon",
      "properties": {
        "codelaboon.wrapperPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Absolute Codelaboon Claude wrapper path; ide install configures this automatically."
        },
        "codelaboon.executablePath": {
          "type": "string",
          "scope": "machine",
          "default": "codelaboon",
          "description": "Codelaboon CLI executable for free-model health checks."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelaboon",
          "title": "Codelaboon",
          "icon": "sessions.svg"
        }
      ]
    },
    "views": {
      "codelaboon": [
        {
          "id": "codelaboon.sessions",
          "name": "Sessions"
        },
        {
          "id": "codelaboon.diagnostics",
          "name": "Diagnostics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codelaboon.sessions",
        "contents": "Continue one conversation across coding agents.\n[Import Session](command:codelaboon.importSession)\n[Convert Between Agents](command:codelaboon.convertSession)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codelaboon.importSession",
          "when": "view == codelaboon.sessions",
          "group": "navigation@0"
        },
        {
          "command": "codelaboon.exportSession",
          "when": "view == codelaboon.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codelaboon.convertSession",
          "when": "view == codelaboon.sessions",
          "group": "navigation@2"
        },
        {
          "command": "codelaboon.refreshSessions",
          "when": "view == codelaboon.sessions",
          "group": "navigation@3"
        },
        {
          "command": "codelaboon.refreshDiagnostics",
          "when": "view == codelaboon.diagnostics",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codelaboon.exportSession",
          "when": "view == codelaboon.sessions && viewItem == codelaboonSession",
          "group": "inline"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zGabrielR1/codelaboon"
  },
  "license": "SEE LICENSE IN LICENSE"
}
