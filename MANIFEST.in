include README.md
include .gitattributes
include WATCH.md
include CLOUD-WATCH.md
include LICENSE
include CHANGELOG.md
include RELEASE-RC26.md
include RELEASE-RC27.md
include RELEASE-RC28.md
include RELEASE-RC39.md
include RELEASE-RC40.md
include RELEASE-RC41.md
include RELEASE-RC42.md
include Makefile
include CURRENTTASK
recursive-include .github/workflows *.yml
recursive-include codelaboon *.py
recursive-include providers *.py
recursive-include config *.py *.example
recursive-include docs *.md *.json
recursive-include examples *.json
recursive-include scripts *.sh
recursive-include scripts *.py *.ps1
recursive-include tests *.py
global-exclude __pycache__
global-exclude *.py[cod]

recursive-include codelaboon/static *.html *.css *.js *.svg
include codelaboon/_vendor/engines.json
exclude codelaboon/_vendor/*.tar.gz
recursive-include codelaboon/prompts *.md
recursive-include codelaboon/themes *.json KILO-LICENSE
recursive-include scripts/patches *.patch
prune codelaboon/_vendor/opencode
prune codelaboon/_vendor/oh-my-pi

recursive-include codelaboon/integrations/vscode *.json *.js *.md
include codelaboon/integrations/claude-browser/manifest.json
include codelaboon/integrations/claude-browser/background.js
include codelaboon/integrations/claude-browser/content.js

recursive-include scripts *.js
