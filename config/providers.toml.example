# Provider configuration template for codelaboon.
#
# Copy this file to ~/.config/codelaboon/providers.toml (created with
# restrictive permissions on first run) and fill in your API keys.
# Never commit a file containing real API keys.

[chatgpt]
api_key = ""
models = ["gpt-3.5-turbo"]

[nvidia]
api_key = ""
models = ["nemotron-3"]

[openrouter]
api_key = ""
models = ["openai/gpt-3.5-turbo"]

[luna]
api_key = ""
models = ["luna-2"]

# dsh-our-free-model local forward gateway. Enable the forward listener in the
# plugin (Settings -> Our Free Model -> Local Forwarding), then copy its base
# URL and generated key (`ofm-...`) here. Model discovery is live from the
# gateway; `models` is only the offline fallback. Every model on the lane is
# free — DeepSeek V4.1 Flash leads the list.
[ourfree]
api_key = ""
base_url = "http://127.0.0.1:18899/v1"
models = [
    "deepseek-v4.1-flash-free",
    "deepseek-v4-flash-free",
    "glm-5.3-flash-free",
    "mimo-v2.6-flash-free",
    "mimo-v2.5-free",
    "nemotron-3-ultra-free",
    "nemotron-3.5-lightning-free",
    "ling-3.0-flash-fin-free",
    "space-bunny-free",
    "union-alpha",
    "muse-spark-1.3-contributor-free",
    "muse-spark-1.2-contributor-free",
    "jev-1.13-free",
]

# Kilo AI's public gateway free pool — completely keyless, no account at all.
# The roster below is only the offline fallback: discovery filters the
# gateway's live listing down to its `isFree` slice on every run.
# Note: free-pool prompts may be logged upstream — keep secrets off this lane.
[kilo]
api_key = ""
models = ["kilo-auto/free", "openrouter/free"]
