# Provider configuration template for codelaboon.
#
# Copy this file to ~/.config/codelaboon/providers.toml (created with
# restrictive permissions on first run) and fill in your API keys.
# Never commit a file containing real API keys.

[chatgpt]
api_key = ""
models = ["gpt-3.5-turbo"]

# Claude: leave api_key empty and run `codelaboon login claude` to use a
# claude.ai plan (Pro/Max/Ultra/Team/Enterprise). Free claude.ai accounts can
# connect, but Anthropic currently grants no Claude Code/API inference on the
# free plan. An ANTHROPIC_API_KEY or a key here takes precedence.
[claude]
api_key = ""
models = []

# Gemini: leave api_key empty and run `codelaboon configure gemini` once to
# import a free Desktop OAuth client, then `codelaboon login gemini` to sign in
# with a Google account and onboard the free Code Assist tier (no billing
# account, no key). Free-tier data policy applies. GEMINI_API_KEY/GOOGLE_API_KEY
# or a key here uses the AI Studio API instead.
[gemini]
api_key = ""
models = []

# Freebuff: leave api_key empty and run `codelaboon login freebuff` to sign in
# with a Freebuff account (device-code login — the same flow the Freebuff CLI
# uses). No subscription, no credits, no API key: free sessions are funded by
# ads and admitted per model for an hour. Free-tier data policy applies; use
# it for throwaway work, not secrets. An explicit token below, or
# CODEBUFF_API_KEY / FREEBUFF_API_KEY, takes precedence.
[freebuff]
api_key = ""
models = []

# Qoder: leave api_key empty and run `codelaboon login qoder` to sign in
# with a Qoder account (browser device flow — the same flow the Qoder CLI
# uses). Qoder accounts include a free plan. Chat runs through the official
# qodercli binary when it is installed (`curl -fsSL https://qoder.com/install
# | bash`, then `qoder login`), because Qoder's inference gateway only
# accepts requests signed by that client. A Personal Access Token from
# https://qoder.com/account/integrations can be pasted below or set as
# QODER_PERSONAL_ACCESS_TOKEN instead.
[qoder]
api_key = ""
models = []

[nvidia]
api_key = ""
models = ["nemotron-3"]

[openrouter]
api_key = ""
models = ["openai/gpt-3.5-turbo"]

[luna]
api_key = ""
models = ["luna-2"]

# dsh-our-free-model local forward gateway. Enable the forward listener in the
# plugin (Settings -> Our Free Model -> Local Forwarding), then copy its base
# URL and generated key (`ofm-...`) here. Model discovery is live from the
# gateway; `models` is only the offline fallback. Every model on the lane is
# free — DeepSeek V4.1 Flash leads the list.
[ourfree]
api_key = ""
base_url = "http://127.0.0.1:18899/v1"
models = [
    "deepseek-v4.1-flash-free",
    "deepseek-v4-flash-free",
    "glm-5.3-flash-free",
    "mimo-v2.6-flash-free",
    "mimo-v2.5-free",
    "nemotron-3-ultra-free",
    "nemotron-3.5-lightning-free",
    "ling-3.0-flash-fin-free",
    "space-bunny-free",
    "union-alpha",
    "muse-spark-1.3-contributor-free",
    "muse-spark-1.2-contributor-free",
    "jev-1.13-free",
]

# Kilo AI's public gateway free pool — completely keyless, no account at all.
# The roster below is only the offline fallback: discovery filters the
# gateway's live listing down to its `isFree` slice on every run.
# Note: free-pool prompts may be logged upstream — keep secrets off this lane.
[kilo]
api_key = ""
models = ["kilo-auto/free", "openrouter/free"]

# Pollinations' public text API — keyless and OpenAI-compatible. The
# anonymous tier needs no account; an optional token below raises limits.
# Discovery is live from https://text.pollinations.ai/models.
# Note: free-tier prompts may be logged upstream — keep secrets off this lane.
[pollinations]
api_key = ""
models = ["openai-fast"]

# Sign up at https://wusrouter.com/ and create an API key.
# Public model discovery stays live; models is an optional offline fallback.
[wusrouter]
api_key = ""
models = []

# Free-only OpenRouter catalog; use an API key or OPENROUTER_API_KEY.
# The official [openrouter] key is reused automatically when this key is empty.
[openrouter_free]
api_key = ""
models = []

# Z.AI's explicitly zero-priced GLM Flash lane (API key required; ZAI_API_KEY supported).
# Paid FlashX/GLM5 models are never allowed on this lane.
[zai_free]
api_key = ""
models = []

# Live account catalogue; not automatically treated as zero-cost.
[howtofix]
api_key = ""
models = []

[copilot]
api_key = ""
models = []

# Vercel AI Gateway: API key or AI_GATEWAY_API_KEY (not a Vercel account token).
# This unrestricted lane is outside free Auto. Model IDs include vendor/ID.
[vercel]
api_key = ""
base_url = "https://ai-gateway.vercel.sh/v1"
models = []

# Free Auto uses only live, uniformly zero-priced Vercel text models.
# Reuses [vercel]'s key on the same endpoint, or AI_GATEWAY_API_KEY.
# Configured model IDs never bypass live pricing validation.
[vercel_free]
api_key = ""
models = []
